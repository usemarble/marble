{
  "name": "marblecms",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "db:migrate": "pnpm --filter @marble/db db:migrate",
    "db:generate": "pnpm --filter @marble/db db:generate",
    "db:studio": "pnpm --filter @marble/db db:studio",
    "db:push": "pnpm --filter @marble/db db:push",
    "db:pull": "pnpm --filter @marble/db db:pull",
    "build": "turbo run build",
    "web:build": "turbo run build --filter=web",
    "cms:build": "turbo run build --filter=cms",
    "web:start": "pnpm --filter web preview",
    "cms:start": "pnpm --filter cms start",
    "dev": "turbo run dev",
    "cf-typegen:check": "pnpm --filter api --filter jobs --filter mcp run cf-typegen:check",
    "lint": "turbo run lint",
    "lint:root": "biome check package.json turbo.json biome.jsonc commitlint.config.ts skills-lock.json tsconfig.json .vscode",
    "format": "biome check --write .",
    "web:dev": "turbo run dev --filter=web",
    "cms:dev": "turbo run dev --filter=cms",
    "api:dev": "turbo run dev --filter=api",
    "workers:dev": "pnpm --filter api exec wrangler dev -c wrangler.jsonc -c ../jobs/wrangler.jsonc --env development --persist-to ../../.wrangler/state",
    "docs:dev": "turbo run dev --filter=docs",
    "mcp:dev": "turbo run dev --filter=mcp",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@marble/tsconfig": "workspace:*",
    "husky": "^9.1.7",
    "turbo": "2.11.3",
    "typescript": "^5.9.3",
    "ultracite": "7.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  }
}
