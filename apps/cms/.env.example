# The CMS reads public values only. Secrets and the database live on the API Worker (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://marblecms.com

# Databuddy (optional; analytics is off without a dashboard client ID)
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=
NEXT_PUBLIC_DATABUDDY_WEB_CLIENT_ID=
