{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node", "./.cloudflare/types/index.d.ts"],
    "skipLibCheck": true,
    "lib": ["ESNext", "WebWorker"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".cloudflare/types/index.d.ts",
    "cloudflare.config.ts"
  ]
}
