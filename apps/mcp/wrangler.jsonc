{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marble-mcp",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public/"
  },
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "placement": { "mode": "smart" },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
