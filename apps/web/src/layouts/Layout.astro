---
  import SpeedInsights from "@vercel/speed-insights/astro";
  import FooterComponent from "@/components/Footer.astro";
  import HeadComponent from "@/components/Head.astro";
  import HeaderComponent from "@/components/Header.astro";
  import ScrollToTop from "@/components/ScrollToTop.astro";
  import ThemeScript from "@/components/ThemeScript.astro";

  const {
    title,
    description,
    image,
    imageAlt,
    canonical,
    noindex,
    structuredData,
    ogType,
    publishedTime,
    modifiedTime,
    articleAuthors,
  } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <HeadComponent
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonical={canonical}
      noindex={noindex}
      structuredData={structuredData}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleAuthors={articleAuthors}
    />
    <ThemeScript/>
  </head>
  <body>
    <HeaderComponent/>
    <main>
      <slot/>
    </main>
    <FooterComponent/>
    <ScrollToTop/>
    <SpeedInsights/>
    <script>
      import { getTrackingParams } from "@databuddy/sdk";
      import { SITE } from "@/lib/constants/site";

      // Carry the anonymous marketing visit into the registration flow.
      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) {
            return;
          }
          const link = target.closest<HTMLAnchorElement>("a[href]");
          if (!link) {
            return;
          }

          const destination = new URL(link.href);
          if (
            destination.origin !== new URL(SITE.APP_URL).origin ||
            destination.pathname !== "/register"
          ) {
            return;
          }

          const params = new URLSearchParams(getTrackingParams());
          for (const [key, value] of params) {
            destination.searchParams.set(key, value);
          }
          link.href = destination.toString();
        },
        true
      );
    </script>
  </body>
</html>
