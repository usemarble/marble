---
  import Container from "@/components/Container.astro";
  import ButtonComponent from "@/components/ui/Button.astro";
  import { REGISTER_URL, TRACKING_EVENTS } from "@/lib/constants/tracking";

  interface Props {
    title: string;
    description: string;
    /** Distinguishes this signup button in the signup_clicked event. */
    context: string;
    secondary: {
      href: string;
      label: string;
    };
  }

  const { title, description, context, secondary } = Astro.props;
  const secondaryIsExternal = secondary.href.startsWith("http");
---
<section>
  <Container class="py-12 md:py-20">
    <div
      class="flex w-full flex-col items-center gap-6 rounded-xl bg-surface px-6 py-12 text-center md:px-10 md:py-16"
    >
      <div class="space-y-4">
        <h2
          class="text-2xl tracking-tight text-balance md:text-3xl lg:text-4xl"
        >
          {title}
        </h2>
        <p class="mx-auto max-w-2xl text-muted-foreground md:text-lg">
          {description}
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <ButtonComponent
          href={REGISTER_URL}
          target="_blank"
          class="w-full sm:w-auto"
          data-track={TRACKING_EVENTS.signupClicked}
          data-context={context}
          data-label="Start for free"
        >
          Start for free
        </ButtonComponent>
        <ButtonComponent
          href={secondary.href}
          target={secondaryIsExternal ? "_blank" : undefined}
          rel={secondaryIsExternal ? "noopener" : undefined}
          variant="secondary"
          class="w-full sm:w-auto"
        >
          {secondary.label}
        </ButtonComponent>
      </div>
    </div>
  </Container>
</section>
