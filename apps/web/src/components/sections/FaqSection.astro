---
  import Container from "@/components/Container.astro";
  import AccordionItem from "@/components/ui/AccordionItem.astro";

  interface Props {
    faqs: Array<{ question: string; answer: string }>;
    name: string;
    description: string;
  }

  const { faqs, name, description } = Astro.props;
---
<section>
  <Container class="py-16 md:py-24">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-20">
      <div class="space-y-4">
        <h2
          class="text-2xl tracking-tight text-balance md:text-3xl lg:text-4xl"
        >
          Frequently asked questions
        </h2>
        <p class="text-muted-foreground">{description}</p>
      </div>
      <div class="lg:col-span-2">
        {faqs.map((faq) => (
          <AccordionItem name={name} title={faq.question}>
            <p
              class="faq-answer pb-2 text-sm leading-relaxed text-muted-foreground"
              set:html={faq.answer}
            />
          </AccordionItem>
        ))}
      </div>
    </div>
  </Container>
</section>
