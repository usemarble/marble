# Local Postgres for the HYPERDRIVE binding (docker-compose default; point it at a Neon dev branch instead if you prefer).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://usemarble:justusemarble@localhost:5432/marble
RESEND_API_KEY=
# The Redis HTTP proxy from docker-compose. Scheduled publishing clears the API read cache.
REDIS_URL=http://localhost:8079
REDIS_TOKEN=justusemarble
