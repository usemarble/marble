{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["transit", "//#lint:root"]
    },
    "//#lint:root": {
      "inputs": [
        "package.json",
        "turbo.json",
        "biome.jsonc",
        "commitlint.config.ts",
        "skills-lock.json",
        "tsconfig.json",
        ".vscode/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
